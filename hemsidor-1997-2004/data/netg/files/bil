;;; data types for person model - constructor and selectors
;;; (person ((starttime endtime channel) 
;;;           ...
;;;         ))

(define (create-model person)
  (list person '()))

(define (model-person model)
  (car model))

(define (model-zones model)
  (cadr model))

(define (create-zone time channel)
  (list time (list channel)))

(define (zone-time zone)
  (car zone))

(define (zone-channels zone)
  (cadr zone))

(define (update-zone zone channel)
  (let ((zone-t (zone-time zone))
	  (zone-cs (zone-channels zone)))
    (list zone-t (cons channel zone-cs))))


;;; very simple learning function; takes a person model + a list of events
;;; and returns the refined model

(define (learn model events)
  (if (null? events)
      model
      (learn (learnone model (car events)) (cdr events))))

(define (learnone model event)
  (let ((name (model-person model))
	  (zones (model-zones model))
	  (time (event-time event))
	  (channel (event-channel event)))
    (list name (update zones time channel))))

(define (update zones time channel)
  (if (null? zones)
      (list (create-zone time channel))
      (let* ((zone (car zones))
	       (zone-t (zone-time zone))
	       (zone-cs (zone-channels zone))
	       (rest (cdr zones))
	      )
	  (cond ((= time zone-t)
	         (cons (update-zone zone channel)
		         rest))
	        ((> zone-t time)
	         (cons (create-zone time channel)
		         zones))
	        (else
	         (cons zone
		         (update rest time channel)))))))










