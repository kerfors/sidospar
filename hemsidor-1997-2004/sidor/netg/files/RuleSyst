(define *rules* ())

(define (init)
  (set! *rules* ()))

(define (add-rule! r)
  (set! *rules* (cons r *rules*)))

(define (make-rule ant conc)
  (cons ant conc))

(define rule-antecedent car)

(define rule-conclusion cdr)

(define (backward v known)
  (if (memq v known)
      #t ; trivialt sant
      (let ((rs (filter (lambda (r) (eq? v (rule-conclusion r)))
			 *rules*))) ; hitta alla anvandbara regler
	(lor (map (lambda (r) (land (map (lambda (v) (backward v known))
				    (rule-antecedent r))))
	     rs)))))

(define (forward known)
  (let ((new (set-minus 
	      (concmap (lambda(r) (if (null?
				       (filter (lambda (v)
						 (not (memq v known)))
					       (rule-antecedent r)))
				      (list (rule-conclusion r))
				      ()))
		       *rules*)
	      known)))
    (if (null? new)
	known
	(forward (append new known)))))

    

;;; Exempel
;
; A ocb B -> C
; C -> D
; E -> D
; A och D -> F
;
;;;

(define (tst)
  (begin (init)
	 (add-rule! (make-rule '(A B) 'C))
	 (add-rule! (make-rule '(C) 'D))
	 (add-rule! (make-rule '(E) 'D))
	 (add-rule! (make-rule '(A D) 'F))))

;;; Utility
	 
(define (filter p l)
  (if (null? l)
      '()
      (let ((fst (car l))
	    (rst (filter p (cdr l))))
	(if (p fst)
	    (cons fst rst)
	    rst))))

(define (reduce f b l)
  (if (null? l)
  b
  (f (car l) (reduce f b (cdr l)))))


(define (concmap f l)
  (reduce append '() (map f l)))

(define (set-minus s1 s2)
  (if (null? s1)
      '()
      (if (member (car s1) s2)
	  (set-minus (cdr s1) s2)
	  (cons (car s1) (set-minus (cdr s1) s2)))))


(define (lor l)
  (reduce orf #f l))

(define (orf x y)
  (or x y))

(define (land l)
  (reduce andf #t l))

(define (andf x y)
  (and x y))





	