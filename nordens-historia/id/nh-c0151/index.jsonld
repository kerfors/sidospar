   "dcterms:identifier": "ra-007",
   "itemReviewed": "nh:nh-c0151",
   "reviewRating": {
    "@type": "Rating",
    "alternateName": "bekräftad"
   },
   "reviewBody": "SBL: Erik av Pommern krönt till konung i de tre rikena i Kalmar 17 juni 1397, ensamregent vid Margaretas död i oktober 1412, avsatt i Sverige omkring 29 september 1439. Margareta död 28 oktober 1412. SDHK registrerar kröningsbrevet och Kalmardokumentet från juli 1397.",
   "datePublished": "2026-10-18",
   "prov:wasGeneratedBy": "nh:#kontroll-riksarkivet-2026-10-18",
   "citation": [
    {
     "@id": "https://sok.riksarkivet.se/sbl/Presentation.aspx?id=15392",
     "name": "SBL: Erik av Pommern",
     "isPartOf": "nh:#register-sbl"
    },
    {
