    schema:itemReviewed nh:nh-c0151 ;
    schema:reviewBody "SBL: Erik av Pommern krönt till konung i de tre rikena i Kalmar 17 juni 1397, ensamregent vid Margaretas död i oktober 1412, avsatt i Sverige omkring 29 september 1439. Margareta död 28 oktober 1412. SDHK registrerar kröningsbrevet och Kalmardokumentet från juli 1397." ;
    schema:reviewRating [ a schema:Rating ;
            schema:alternateName "bekräftad" ] .

